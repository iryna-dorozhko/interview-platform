{
  "compilerOptions": {
    "lib": ["esnext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "esnext",
    "checkJs": false
  },
  "vueCompilerOptions": {
    "target": 3,
    "globalTypesPath": "./src/auto-imports.d.ts"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"]
}

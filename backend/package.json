{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun --env-file=.env --watch src/server.ts",
    "build": "tsc",
    "start": "bun --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=.env vitest run src/",
    "db:validate": "bun --env-file=.env prisma validate",
    "db:generate": "bun --env-file=.env prisma generate",
    "predb:migrate": "bun --env-file=.env prisma generate",
    "db:migrate": "bun --env-file=.env prisma migrate dev",
    "predb:seed": "bun --env-file=.env prisma generate",
    "db:seed": "bun --env-file=.env prisma db seed",
    "llm:test": "bun --env-file=.env scripts/llm-test.ts"
  },
  "prisma": {
    "seed": "bun --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nitra/check-env": "^4.2.1",
    "@prisma/client": "^7.8.0",
    "@qzsy/prisma-adapter-bun": "^0.6.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "ISC"
}

{
  "name": "interview-platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "bun run --filter backend dev & bun run --filter frontend dev",
    "mcp:browser": "playwright-mcp --port 8931",
    "build": "bun run --workspaces build",
    "lint:ox": "oxlint frontend backend",
    "lint:eslint": "eslint frontend backend",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "bun run lint:ox && bun run lint:eslint && bun run typecheck",
    "ci:bootstrap": "bun run lint && bun run build"
  },
  "devDependencies": {
    "@7n/rules": "^1.92.0",
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.78",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.61.1",
    "typescript-eslint": "^8.67.0",
    "vue-eslint-parser": "^10.4.1"
  }
}

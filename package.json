{
  "name": "interview-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter backend dev & bun run --filter frontend dev",
    "mcp:browser": "bunx @playwright/mcp --port 8931",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter backend test && bun run --filter frontend test",
    "coverage": "npx @7n/rules lint test --no-fix",
    "ci:bootstrap": "npx @7n/rules lint --full && bun run build"
  },
  "devDependencies": {
    "@7n/rules": "^1.92.0",
    "@7n/rules-lang-js": "^0.26.2",
    "@nitra/cspell-dict": "^2.0.0",
    "@nitra/eslint-config": "^3.10.0",
    "@nitra/stylelint-config": "^1.4.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.61.1",
    "vitest": "^4.1.10"
  },
  "stylelint": {
    "extends": "@nitra/stylelint-config"
  }
}
